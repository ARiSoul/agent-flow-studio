# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets and configuration of this machine
.env
connections.yaml
CLAUDE.local.md
.claude/settings.local.json

# Runs (artifacts, audit, decisions)
runs/*
!runs/.gitkeep

# Local extensions (internal code): only the README is public
extensions/*
!extensions/README.md

# Local agent library (saved from the editor): only the README is public
agents/*
!agents/README.md

# Flows: local by default (they may name internal systems). Public examples are listed one by one.
flows/*
!flows/repo-review/

# Flows: editor trash and backups
flows/.trash/
*.bak
*.tmp

# Frontend
editor/node_modules/
src/agent_flow_studio/editor/static/

# Saved assistant commands (editor; may hold internal instructions)
assistant_commands.yaml

# Words that must not go to the public repo (one per line; checked when a public flow is saved)
private_terms.txt

# workspaces kept in the studio (machine-local, may name private systems)
/workspaces/
